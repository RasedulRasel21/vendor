generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shop                    String    @id
  commissionPercent       Decimal   @default(10) @db.Decimal(5, 2)
  commissionFixed         Decimal   @default(0) @db.Decimal(12, 2)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
  setupGuideDismissedAt   DateTime?
  currencyCode            String?
  collectionsSyncedAt     DateTime?
  codRulesCustomizationId String?
  countryCode             String?
  fulfillmentDays         Int       @default(3)
  restockLocationId       String?
  restockLocationName     String?
  labelAccount            String?
  labelApiKey             String?
  labelProvider           String?
  payoutMinimum           Decimal   @default(0) @db.Decimal(12, 2)
  payoutRequests          Boolean   @default(true)
  payoutSchedule          String    @default("MANUAL")
  refundKeepsCommission   Boolean   @default(false)
  autoInvoices            Boolean   @default(false)
  businessAddress         String?
  businessName            String?
  businessTaxId           String?
  commissionTaxRate       Decimal   @default(0) @db.Decimal(5, 2)
  invoicePrefix           String    @default("SV-")
  taxLabel                String    @default("VAT")
  dac7MinAmount           Decimal   @default(2000) @db.Decimal(12, 2)
  dac7MinTransactions     Int       @default(30)
  us1099kAmount           Decimal   @default(20000) @db.Decimal(12, 2)
  us1099kTransactions     Int       @default(200)
  payoutFxEnabled         Boolean   @default(false)
  payoutFxRates           Json?
  autoSendPayouts         Boolean   @default(false)
  paypalAccount           String?
  paypalCredentials       String?
  paypalMode              String?
  stripeAccount           String?
  stripeSecretKey         String?
  payoutHoldUnit          String    @default("DAYS")
  payoutHoldValue         Int       @default(7)
  payoutMinimumEnabled    Boolean   @default(false)
  shopEmail               String?
  shopName                String?
  payoutFxAuto            Boolean   @default(true)
  payoutFxBase            String?
  payoutFxRatesAt         DateTime?
  payoutFxSource          String?
  payoutChangeHoldEnabled Boolean   @default(true)
  payoutChangeHoldHours   Int       @default(48)
}

model Vendor {
  id                  String                @id
  shop                String
  name                String
  handle              String
  email               String
  phone               String?
  status              VendorStatus          @default(PENDING)
  statusReason        String?
  notes               String?
  approvedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  commissionFixed     Decimal?              @db.Decimal(12, 2)
  commissionPercent   Decimal?              @db.Decimal(5, 2)
  codEnabled          Boolean               @default(true)
  codMaxOrderValue    Decimal?              @db.Decimal(12, 2)
  shippingMode        ShippingMode          @default(VENDOR_SHIPS)
  addressLine1        String?
  addressLine2        String?
  city                String?
  countryCode         String?
  payoutDetails       Json?
  payoutMethod        PayoutMethod?
  payoutUpdatedAt     DateTime?
  postalCode          String?
  taxIdEncrypted      String?
  taxInfo             Json?
  taxInfoUpdatedAt    DateTime?
  stripeAccountId     String?
  CommissionInvoice   CommissionInvoice[]
  LedgerEntry         LedgerEntry[]
  OrderLineVendor     OrderLineVendor[]
  Payout              Payout[]
  ProductSubmission   ProductSubmission[]
  VendorActivity      VendorActivity[]
  VendorChangeRequest VendorChangeRequest[]
  VendorOrder         VendorOrder[]
  VendorProduct       VendorProduct[]
  VendorUser          VendorUser[]

  @@unique([shop, email])
  @@unique([shop, handle])
  @@index([shop, status])
}

model VendorActivity {
  id        String   @id
  vendorId  String
  action    String
  actor     String
  details   Json?
  createdAt DateTime @default(now())
  Vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model VendorProduct {
  id        String   @id
  shop      String
  vendorId  String
  productId String
  createdAt DateTime @default(now())
  Vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([shop, productId])
  @@index([vendorId])
}

model VendorSession {
  id           String     @id
  tokenHash    String     @unique
  vendorUserId String
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  VendorUser   VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)

  @@index([vendorUserId])
}

model VendorUser {
  id                  String           @id
  vendorId            String
  email               String
  name                String?
  role                VendorUserRole   @default(OWNER)
  status              VendorUserStatus @default(INVITED)
  inviteTokenHash     String?          @unique
  inviteExpiresAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  passwordHash        String?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  VendorSession       VendorSession[]
  Vendor              Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, email])
}

model ProductSubmission {
  id                 String                  @id
  shop               String
  vendorId           String
  submittedById      String?
  status             ProductSubmissionStatus @default(DRAFT)
  title              String
  description        String?
  productType        String?
  tags               String[]
  price              Decimal?                @db.Decimal(12, 2)
  compareAtPrice     Decimal?                @db.Decimal(12, 2)
  sku                String?
  barcode            String?
  inventoryQuantity  Int?
  imageUrls          String[]
  productId          String?
  reviewNote         String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime
  collectionIds      String[]
  descriptionHtml    String?
  handle             String?
  options            Json?
  seoDescription     String?
  seoTitle           String?
  trackInventory     Boolean                 @default(true)
  variants           Json?
  pendingDraft       Json?
  pendingReviewNote  String?
  pendingSubmittedAt DateTime?
  Vendor             Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([vendorId, status])
}

model ShopCollection {
  id           String   @id
  shop         String
  collectionId String
  title        String
  handle       String
  imageUrl     String?
  syncedAt     DateTime @default(now())

  @@unique([shop, collectionId])
  @@index([shop, title])
}

model VendorChangeRequest {
  id            String              @id
  shop          String
  vendorId      String
  type          ChangeRequestType
  status        ChangeRequestStatus @default(PENDING)
  requested     Json
  previous      Json?
  requestedById String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  Vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([vendorId, type, status])
}

model VendorOrder {
  id                    String             @id
  shop                  String
  vendorId              String
  status                VendorOrderStatus  @default(OPEN)
  orderId               String
  orderName             String
  currencyCode          String
  financialStatus       String?
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  shippingAddress       Json?
  subtotal              Decimal            @db.Decimal(12, 2)
  commission            Decimal            @db.Decimal(12, 2)
  shipping              Decimal            @default(0) @db.Decimal(12, 2)
  earnings              Decimal            @db.Decimal(12, 2)
  placedAt              DateTime
  fulfilledAt           DateTime?
  cancelledAt           DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime
  shippingMode          ShippingMode       @default(VENDOR_SHIPS)
  paidAt                DateTime?
  refunded              Decimal            @default(0) @db.Decimal(12, 2)
  refundedCommission    Decimal            @default(0) @db.Decimal(12, 2)
  refundedEarnings      Decimal            @default(0) @db.Decimal(12, 2)
  vendorSeenAt          DateTime?
  deliveryMethod        String?
  presentmentCurrency   String?
  presentmentSubtotal   Decimal?           @db.Decimal(12, 2)
  shippingMethod        String?
  refundedAt            DateTime?
  acceptedAt            DateTime?
  refundKeepsCommission Boolean            @default(false)
  LedgerEntry           LedgerEntry[]
  Vendor                Vendor             @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  VendorOrderIssue      VendorOrderIssue[]
  VendorOrderLine       VendorOrderLine[]
  VendorReturn          VendorReturn[]
  VendorShipment        VendorShipment[]

  @@unique([shop, orderId, vendorId])
  @@index([shop, status])
  @@index([vendorId, status])
}

model VendorOrderLine {
  id                         String      @id
  vendorOrderId              String
  lineItemId                 String
  title                      String
  variantTitle               String?
  sku                        String?
  imageUrl                   String?
  quantity                   Int
  unitPrice                  Decimal     @db.Decimal(12, 2)
  subtotal                   Decimal     @db.Decimal(12, 2)
  commission                 Decimal     @db.Decimal(12, 2)
  earnings                   Decimal     @db.Decimal(12, 2)
  fulfillmentOrderId         String?
  fulfillmentOrderLineItemId String?
  fulfillableQuantity        Int         @default(0)
  refundedQuantity           Int         @default(0)
  refundedSubtotal           Decimal     @default(0) @db.Decimal(12, 2)
  shippedQuantity            Int         @default(0)
  presentmentSubtotal        Decimal?    @db.Decimal(12, 2)
  requiresShipping           Boolean     @default(true)
  tax                        Decimal     @default(0) @db.Decimal(12, 2)
  weight                     Decimal?    @db.Decimal(10, 3)
  weightUnit                 String?
  VendorOrder                VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
}

model VendorShipment {
  id              String      @id
  vendorOrderId   String
  fulfillmentId   String?
  trackingCompany String?
  trackingNumber  String?
  trackingUrl     String?
  items           Json
  shippedBy       String
  createdAt       DateTime    @default(now())
  VendorOrder     VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId])
  @@index([vendorOrderId])
}

model ShopCarrier {
  id                  String        @id
  shop                String
  name                String
  trackingUrlTemplate String?
  status              CarrierStatus @default(PENDING)
  reason              String?
  reviewNote          String?
  requestedByVendorId String?
  reviewedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime

  @@unique([shop, name])
  @@index([shop, status])
}

model VendorReturn {
  id            String      @id
  vendorOrderId String
  returnId      String
  name          String?
  status        String
  items         Json
  requestedAt   DateTime    @default(now())
  updatedAt     DateTime
  VendorOrder   VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@unique([vendorOrderId, returnId])
  @@index([vendorOrderId])
}

model VendorOrderIssue {
  id            String           @id
  vendorOrderId String
  reason        String
  note          String?
  status        OrderIssueStatus @default(OPEN)
  reviewNote    String?
  createdAt     DateTime         @default(now())
  resolvedAt    DateTime?
  VendorOrder   VendorOrder      @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([vendorOrderId])
}

model OrderLineVendor {
  id           String   @id
  shop         String
  orderId      String
  lineItemId   String
  vendorId     String
  fromVendorId String?
  title        String
  movedBy      String
  createdAt    DateTime @default(now())
  Vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([shop, orderId, lineItemId])
  @@index([shop, orderId])
  @@index([vendorId])
}

model WebhookEvent {
  id         String   @id
  shop       String
  topic      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}

model LedgerEntry {
  id            String          @id
  shop          String
  vendorId      String
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2)
  currencyCode  String
  vendorOrderId String?
  orderName     String?
  payoutId      String?
  description   String
  createdBy     String
  createdAt     DateTime        @default(now())
  Payout        Payout?         @relation(fields: [payoutId], references: [id])
  Vendor        Vendor          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  VendorOrder   VendorOrder?    @relation(fields: [vendorOrderId], references: [id])

  @@index([payoutId])
  @@index([shop, vendorId, createdAt])
  @@index([vendorOrderId])
}

model Payout {
  id             String        @id
  shop           String
  vendorId       String
  amount         Decimal       @db.Decimal(12, 2)
  currencyCode   String
  status         PayoutStatus  @default(PENDING)
  method         PayoutMethod?
  details        Json?
  reference      String?
  note           String?
  requestedAt    DateTime?
  createdBy      String
  createdAt      DateTime      @default(now())
  paidAt         DateTime?
  cancelledAt    DateTime?
  updatedAt      DateTime
  fxRate         Decimal?      @db.Decimal(18, 8)
  payoutAmount   Decimal?      @db.Decimal(14, 2)
  payoutCurrency String?
  provider       String?
  providerRef    String?
  providerStatus String?
  sentAt         DateTime?
  LedgerEntry    LedgerEntry[]
  Vendor         Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([vendorId, createdAt])
}

model CommissionInvoice {
  id           String   @id
  shop         String
  vendorId     String
  number       String
  sequence     Int
  periodStart  DateTime
  periodEnd    DateTime
  currencyCode String
  net          Decimal  @db.Decimal(12, 2)
  taxLabel     String
  taxRate      Decimal  @db.Decimal(5, 2)
  taxAmount    Decimal  @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  lines        Json
  seller       Json
  buyer        Json
  issuedAt     DateTime @default(now())
  Vendor       Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([shop, number])
  @@unique([shop, vendorId, periodStart])
  @@index([vendorId, issuedAt])
}

model EmailMessage {
  id          String      @id
  shop        String
  to          String
  subject     String
  text        String
  html        String?
  template    String
  status      EmailStatus @default(QUEUED)
  error       String?
  providerId  String?
  relatedType String?
  relatedId   String?
  createdAt   DateTime    @default(now())
  sentAt      DateTime?

  @@index([shop, createdAt])
}

enum ShippingMode {
  VENDOR_SHIPS
  STORE_SHIPS
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VendorUserRole {
  OWNER
  STAFF
}

enum VendorUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ProductSubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChangeRequestType {
  PAYOUT
}

enum PayoutMethod {
  BANK
  BKASH
  NAGAD
  ROCKET
  UPI
  MPESA
  PAYPAL
  PAYONEER
  WISE
  OTHER
  STRIPE
}

enum VendorOrderStatus {
  OPEN
  FULFILLED
  CANCELLED
  PARTIAL
  REFUNDED
}

enum CarrierStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderIssueStatus {
  OPEN
  RESOLVED
  WITHDRAWN
}

enum LedgerEntryType {
  SALE
  REFUND
  CANCELLATION
  ADJUSTMENT
  PAYOUT
  PAYOUT_REVERSAL
}

enum PayoutStatus {
  REQUESTED
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}
