generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ShopSettings {
  shop                    String    @id
  commissionPercent       Decimal   @default(10) @db.Decimal(5, 2)
  commissionFixed         Decimal   @default(0) @db.Decimal(12, 2)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime
  setupGuideDismissedAt   DateTime?
  currencyCode            String?
  collectionsSyncedAt     DateTime?
  codRulesCustomizationId String?
  countryCode             String?
}

model Vendor {
  id                  String                @id
  shop                String
  name                String
  handle              String
  email               String
  phone               String?
  status              VendorStatus          @default(PENDING)
  statusReason        String?
  notes               String?
  approvedAt          DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  commissionFixed     Decimal?              @db.Decimal(12, 2)
  commissionPercent   Decimal?              @db.Decimal(5, 2)
  codEnabled          Boolean               @default(true)
  codMaxOrderValue    Decimal?              @db.Decimal(12, 2)
  shippingMode        ShippingMode          @default(VENDOR_SHIPS)
  addressLine1        String?
  addressLine2        String?
  city                String?
  countryCode         String?
  payoutDetails       Json?
  payoutMethod        PayoutMethod?
  payoutUpdatedAt     DateTime?
  postalCode          String?
  ProductSubmission   ProductSubmission[]
  VendorActivity      VendorActivity[]
  VendorChangeRequest VendorChangeRequest[]
  VendorOrder         VendorOrder[]
  VendorProduct       VendorProduct[]
  VendorUser          VendorUser[]

  @@unique([shop, email])
  @@unique([shop, handle])
  @@index([shop, status])
}

model VendorActivity {
  id        String   @id
  vendorId  String
  action    String
  actor     String
  details   Json?
  createdAt DateTime @default(now())
  Vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, createdAt])
}

model VendorProduct {
  id        String   @id
  shop      String
  vendorId  String
  productId String
  createdAt DateTime @default(now())
  Vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([shop, productId])
  @@index([vendorId])
}

model VendorSession {
  id           String     @id
  tokenHash    String     @unique
  vendorUserId String
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  VendorUser   VendorUser @relation(fields: [vendorUserId], references: [id], onDelete: Cascade)

  @@index([vendorUserId])
}

model VendorUser {
  id                  String           @id
  vendorId            String
  email               String
  name                String?
  role                VendorUserRole   @default(OWNER)
  status              VendorUserStatus @default(INVITED)
  inviteTokenHash     String?          @unique
  inviteExpiresAt     DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  passwordHash        String?
  failedLoginAttempts Int              @default(0)
  lockedUntil         DateTime?
  VendorSession       VendorSession[]
  Vendor              Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, email])
}

model ProductSubmission {
  id                 String                  @id
  shop               String
  vendorId           String
  submittedById      String?
  status             ProductSubmissionStatus @default(DRAFT)
  title              String
  description        String?
  productType        String?
  tags               String[]
  price              Decimal?                @db.Decimal(12, 2)
  compareAtPrice     Decimal?                @db.Decimal(12, 2)
  sku                String?
  barcode            String?
  inventoryQuantity  Int?
  imageUrls          String[]
  productId          String?
  reviewNote         String?
  submittedAt        DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime
  collectionIds      String[]
  descriptionHtml    String?
  handle             String?
  options            Json?
  seoDescription     String?
  seoTitle           String?
  trackInventory     Boolean                 @default(true)
  variants           Json?
  pendingDraft       Json?
  pendingReviewNote  String?
  pendingSubmittedAt DateTime?
  Vendor             Vendor                  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([vendorId, status])
}

model ShopCollection {
  id           String   @id
  shop         String
  collectionId String
  title        String
  handle       String
  imageUrl     String?
  syncedAt     DateTime @default(now())

  @@unique([shop, collectionId])
  @@index([shop, title])
}

model VendorChangeRequest {
  id            String              @id
  shop          String
  vendorId      String
  type          ChangeRequestType
  status        ChangeRequestStatus @default(PENDING)
  requested     Json
  previous      Json?
  requestedById String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime
  Vendor        Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([shop, status])
  @@index([vendorId, type, status])
}

model VendorOrder {
  id                  String            @id
  shop                String
  vendorId            String
  status              VendorOrderStatus @default(OPEN)
  orderId             String
  orderName           String
  currencyCode        String
  financialStatus     String?
  customerName        String?
  customerEmail       String?
  customerPhone       String?
  shippingAddress     Json?
  subtotal            Decimal           @db.Decimal(12, 2)
  commission          Decimal           @db.Decimal(12, 2)
  shipping            Decimal           @default(0) @db.Decimal(12, 2)
  earnings            Decimal           @db.Decimal(12, 2)
  placedAt            DateTime
  fulfilledAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  shippingMode        ShippingMode      @default(VENDOR_SHIPS)
  paidAt              DateTime?
  refunded            Decimal           @default(0) @db.Decimal(12, 2)
  refundedCommission  Decimal           @default(0) @db.Decimal(12, 2)
  refundedEarnings    Decimal           @default(0) @db.Decimal(12, 2)
  vendorSeenAt        DateTime?
  deliveryMethod      String?
  presentmentCurrency String?
  presentmentSubtotal Decimal?          @db.Decimal(12, 2)
  shippingMethod      String?
  Vendor              Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  VendorOrderLine     VendorOrderLine[]
  VendorShipment      VendorShipment[]

  @@unique([shop, orderId, vendorId])
  @@index([shop, status])
  @@index([vendorId, status])
}

model VendorOrderLine {
  id                         String      @id
  vendorOrderId              String
  lineItemId                 String
  title                      String
  variantTitle               String?
  sku                        String?
  imageUrl                   String?
  quantity                   Int
  unitPrice                  Decimal     @db.Decimal(12, 2)
  subtotal                   Decimal     @db.Decimal(12, 2)
  commission                 Decimal     @db.Decimal(12, 2)
  earnings                   Decimal     @db.Decimal(12, 2)
  fulfillmentOrderId         String?
  fulfillmentOrderLineItemId String?
  fulfillableQuantity        Int         @default(0)
  refundedQuantity           Int         @default(0)
  refundedSubtotal           Decimal     @default(0) @db.Decimal(12, 2)
  shippedQuantity            Int         @default(0)
  presentmentSubtotal        Decimal?    @db.Decimal(12, 2)
  requiresShipping           Boolean     @default(true)
  tax                        Decimal     @default(0) @db.Decimal(12, 2)
  weight                     Decimal?    @db.Decimal(10, 3)
  weightUnit                 String?
  VendorOrder                VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([vendorOrderId])
}

model VendorShipment {
  id              String      @id
  vendorOrderId   String
  fulfillmentId   String?
  trackingCompany String?
  trackingNumber  String?
  trackingUrl     String?
  items           Json
  shippedBy       String
  createdAt       DateTime    @default(now())
  VendorOrder     VendorOrder @relation(fields: [vendorOrderId], references: [id], onDelete: Cascade)

  @@index([fulfillmentId])
  @@index([vendorOrderId])
}

model ShopCarrier {
  id                  String        @id
  shop                String
  name                String
  trackingUrlTemplate String?
  status              CarrierStatus @default(PENDING)
  reason              String?
  reviewNote          String?
  requestedByVendorId String?
  reviewedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime

  @@unique([shop, name])
  @@index([shop, status])
}

enum ShippingMode {
  VENDOR_SHIPS
  STORE_SHIPS
}

enum VendorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum VendorUserRole {
  OWNER
  STAFF
}

enum VendorUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ProductSubmissionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ChangeRequestType {
  PAYOUT
}

enum PayoutMethod {
  BANK
  BKASH
  NAGAD
  ROCKET
}

enum VendorOrderStatus {
  OPEN
  FULFILLED
  CANCELLED
  PARTIAL
  REFUNDED
}

enum CarrierStatus {
  PENDING
  APPROVED
  REJECTED
}
